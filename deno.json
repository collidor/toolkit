{
    "name": "@collidor/toolkit",
    "version": "0.1.7",
    "license": "MIT",
    "exports": {
        ".": "./src/main.ts",
        "./command": "./src/command.ts",
        "./event": "./src/event.ts",
        "./injector": "./src/injector.ts",
        "./observable-command": "./src/observable-command.ts",
        "./observable-event": "./src/observable-event.ts",
        "./result": "./src/result.ts",
        "./schema-command": "./src/schema-command.ts"
    },
    "compilerOptions": {
        "lib": [
            "deno.window",
            "deno.ns",
            "dom.iterable",
            "ESNext",
            "DOM"
        ]
    },
    "publish": {
        "include": [
            "./src/**/*",
            "README.md",
            "deno.json",
            "deno.lock",
            "LICENSE"
        ],
        "exclude": [
            "dist"
        ]
    },
    "tasks": {
        "dev": "deno run --watch ./src/main.ts"
    },
    "imports": {
        "@std/assert": "jsr:@std/assert@^1.0.11",
        "@std/testing": "jsr:@std/testing@^1.0.9",
        "@collidor/event": "jsr:@collidor/event@^4.3.6",
        "@collidor/command": "jsr:@collidor/command@^7.0.5",
        "@collidor/injector": "jsr:@collidor/injector@^2.4.20",
        "@collidor/schema-command": "jsr:@collidor/schema-command@^1.0.4",
        "@collidor/result": "jsr:@collidor/result@^1.0.5",
        "@collidor/observable-command": "jsr:@collidor/observable-command@^1.0.4",
        "@collidor/observable-event": "jsr:@collidor/observable-event@^1.0.4"
    },
    "lint": {
        "rules": {
            "exclude": [
                "no-explicit-any"
            ],
            "include": [
                "no-console"
            ]
        }
    }
}