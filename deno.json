{
    "name": "@collidor/toolkit",
    "nodeModulesDir": "none",
    "version": "1.1.3",
    "license": "MIT",
    "exports": {
        "./command": "./src/command.ts",
        "./event": "./src/event.ts",
        "./injector": "./src/injector.ts",
        "./observable-command": "./src/observable-command.ts",
        "./observable-event": "./src/observable-event.ts",
        "./result": "./src/result.ts",
        "./schema-command": "./src/schema-command.ts",
        "./struct": "./src/struct.ts"
    },
    "compilerOptions": {
        "lib": [
            "deno.window",
            "deno.ns",
            "dom.iterable",
            "ESNext",
            "DOM"
        ]
    },
    "publish": {
        "include": [
            "./src/**/*",
            "README.md",
            "deno.json",
            "deno.lock",
            "LICENSE"
        ],
        "exclude": [
            "dist"
        ]
    },
    "tasks": {
        "dev": "deno test --watch"
    },
    "imports": {
        "@std/assert": "jsr:@std/assert@^1.0.11",
        "@std/testing": "jsr:@std/testing@^1.0.9",
        "@collidor/event": "jsr:@collidor/event@^4.7.2",
        "@collidor/command": "jsr:@collidor/command@^7.3.4",
        "@collidor/injector": "jsr:@collidor/injector@^2.4.20",
        "@collidor/schema-command": "jsr:@collidor/schema-command@^1.1.2",
        "@collidor/result": "jsr:@collidor/result@^1.0.5",
        "@collidor/observable-command": "jsr:@collidor/observable-command@^1.1.0",
        "@collidor/observable-event": "jsr:@collidor/observable-event@^1.1.0",
        "@collidor/struct": "jsr:@collidor/struct@^0.1.0"
    },
    "lint": {
        "rules": {
            "exclude": [
                "no-explicit-any"
            ],
            "include": [
                "no-console"
            ]
        }
    },
    "exclude": [
        "dist",
        "demo"
    ]
}
