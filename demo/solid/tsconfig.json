{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "strict": false,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "baseUrl": ".",
    "paths": {
      "@demo/shared": ["../shared/index.ts"],
      "@demo/shared/*": ["../shared/*"]
    }
  },
  "include": ["src", "../shared"],
  "exclude": ["../shared/*.test.ts"]
}
